# Copy this file to .env (same directory, or the directory you run sbatch from)
# and fill in your own credentials. .env is gitignored and must never be committed.
#
# Hugging Face token (read access is sufficient) — used by the run_*.slurm jobs
# to download gated model checkpoints (MACE / ORB / UMA-eSEN):
HF_TOKEN=hf_your_token_here
